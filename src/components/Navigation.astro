---
const links = [
	{ name: 'WORKS', href: '/' },
	{ name: 'ARCHIVE', href: '/projects' },
	{ name: 'INFO', href: '/about' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 p-6 md:p-10 pointer-events-none">
	<div class="max-w-7xl mx-auto flex justify-between items-center w-full">
		<!-- Logo Section with Status -->
		<div class="flex items-center gap-4 pointer-events-auto group">
			<a href="/" class="text-lg font-mono font-medium tracking-tight hover:opacity-70 transition-opacity text-text-primary">
				TANG_X_STUDIO <span class="text-text-secondary/20 font-light">/</span> 
			</a>
			<!-- 实时状态装饰 -->
			<div class="hidden lg:flex flex-col text-[8px] font-mono leading-tight text-text-secondary translate-y-[-1px]">
				<span id="nav-time">10:45:23 PM</span>
				<div class="flex gap-2">
					<span>STATUS: DESIGN_MODE</span>
					<span id="theme-status">THEME: LIGHT_MODE</span>
				</div>
			</div>
		</div>
		
		<!-- Nav Links -->
		<div class="flex items-center gap-1 bg-bg-primary/40 backdrop-blur-xl px-1 py-1 border border-text-primary/5 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.1)] pointer-events-auto">
			{links.map((link) => (
				<a 
					href={link.href} 
					class="px-4 py-2 text-[10px] font-mono font-medium text-text-secondary hover:text-text-primary hover:bg-text-primary/5 transition-all relative group"
				>
					{link.name}
					<span class="absolute bottom-0 left-0 w-full h-[1px] bg-text-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
				</a>
			))}
			<!-- Theme Toggle Button -->
			<button 
				id="theme-toggle"
				class="px-4 py-2 text-[10px] font-mono font-medium text-text-secondary hover:text-text-primary hover:bg-text-primary/5 transition-all relative group"
				aria-label="Toggle dark mode"
			>
				TOGGLE
			</button>
		</div>
	</div>
</nav>

<script>
	// 简单的实时时间更新，增加“活着”的感觉
	const updateTime = () => {
		const timeEl = document.getElementById('nav-time');
		if (timeEl) {
			const now = new Date();
			timeEl.innerText = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute: '2-digit', second: '2-digit' });
		}
	};
	setInterval(updateTime, 1000);
	updateTime();

	// 主题切换逻辑
	const handleToggleClick = () => {
		const element = document.documentElement;
		element.classList.toggle("dark");

		const isDark = element.classList.contains("dark");
		localStorage.setItem("theme", isDark ? "dark" : "light");
		updateThemeStatus();
	};

	const updateThemeStatus = () => {
		const statusEl = document.getElementById('theme-status');
		if (statusEl) {
			const isDark = document.documentElement.classList.contains("dark");
			statusEl.innerText = `THEME: ${isDark ? 'DARK_MODE' : 'LIGHT_MODE'}`;
		}
	};

	document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
	updateThemeStatus();

	// 监听 Astro 的页面导航事件以确保脚本在页面跳转后依然生效
	document.addEventListener('astro:after-swap', () => {
		document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
		updateThemeStatus();
	});
</script>
