---
const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "");

const links = [
	{ name: 'WORKS', href: '/' },
	{ name: 'ARCHIVE', href: '/projects' },
	{ name: 'INFO', href: '/about' },
];

const isActive = (path: string) => {
	if (path === '/' && (normalizedPathname === '' || normalizedPathname === '/')) return true;
	if (path !== '/' && normalizedPathname.startsWith(path)) return true;
	return false;
};
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-350 ease-out-expo border-b border-transparent py-6 md:py-8 [&.nav-scrolled]:bg-bg-primary/80 [&.nav-scrolled]:backdrop-blur-xl [&.nav-scrolled]:border-border-primary [&.nav-scrolled]:py-4">
	<div class="max-w-7xl mx-auto flex justify-between items-center w-full px-6 md:px-10">
		<!-- Logo Section with Status -->
		<div class="flex items-center gap-4 group">
			<a href="/" class="text-base md:text-lg font-mono font-medium tracking-tight hover:opacity-70 transition-opacity duration-200 text-text-primary whitespace-nowrap">
				TANG_X_STUDIO <span class="text-text-secondary/20 font-light">/</span>
			</a>
			<!-- 实时状态装饰 -->
			<div class="hidden lg:flex flex-col text-[8px] font-mono leading-tight text-text-secondary translate-y-[-1px]">
				<span id="nav-time">10:45:23 PM</span>
				<div class="flex gap-2">
					<span>STATUS: DESIGN_MODE</span>
					<span id="theme-status">THEME: LIGHT_MODE</span>
				</div>
			</div>
		</div>

		<!-- Desktop Nav Links & Theme Toggle -->
		<div class="flex items-center gap-1">
			<div class="hidden md:flex items-center gap-1">
				{links.map((link, index) => {
					const active = isActive(link.href);
					return (
						<a
							href={link.href}
							class:list={[
								"px-4 py-2 text-[10px] font-mono font-medium transition-colors duration-200 relative group active-scale",
								active ? "text-text-primary" : "text-text-secondary hover:text-text-primary"
							]}
						>
							<span class="relative">
								{link.name}
								<span class:list={[
									"absolute -bottom-0.5 left-0 w-full h-[1px] bg-text-primary transition-transform duration-300 ease-out-expo origin-right",
									active ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100 group-hover:origin-left"
								]}></span>
							</span>
						</a>
					);
				})}
			</div>

			<!-- Theme Toggle Button -->
			<button
				id="theme-toggle"
				class="p-2 ml-2 text-text-secondary hover:text-text-primary transition-colors duration-200 relative group cursor-pointer flex items-center justify-center overflow-hidden active-scale"
				aria-label="Toggle dark mode"
			>
				<!-- Sun icon (visible in light mode) -->
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden transition-transform duration-500 ease-out-expo rotate-0 group-hover:rotate-90"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
				<!-- Moon icon (visible in dark mode) -->
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block transition-transform duration-500 ease-out-expo -rotate-12 group-hover:rotate-0"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>

				<span class="absolute bottom-0 left-0 w-full h-[1px] bg-text-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out-expo origin-left"></span>
			</button>

			<!-- Mobile Menu Toggle -->
			<button
				id="mobile-menu-toggle"
				class="p-2 ml-1 text-text-secondary hover:text-text-primary md:hidden cursor-pointer flex items-center justify-center relative z-[60] active-scale"
				aria-label="Open menu"
			>
				<div class="w-5 h-5 relative flex flex-col justify-center gap-1.5">
					<span class="w-full h-[1px] bg-current transition-all duration-300 ease-out-expo origin-center" id="hamburger-top"></span>
					<span class="w-full h-[1px] bg-current transition-all duration-300 ease-out-expo origin-center" id="hamburger-bottom"></span>
				</div>
			</button>
		</div>
	</div>

	<!-- Mobile Menu Overlay -->
	<div
		id="mobile-menu"
		class="fixed inset-0 bg-bg-primary/95 backdrop-blur-xl z-[55] flex flex-col items-center justify-center transition-all duration-500 ease-out-expo opacity-0 pointer-events-none translate-y-4"
	>
		<div class="flex flex-col items-center gap-8">
			{links.map((link) => (
				<a
					href={link.href}
					class="text-2xl font-mono font-medium text-text-secondary hover:text-text-primary transition-colors duration-200 tracking-widest"
				>
					{link.name}
				</a>
			))}

			<div class="mt-12 flex flex-col items-center gap-2">
				<span class="text-[8px] font-mono text-text-secondary opacity-50 uppercase tracking-[0.3em]">Status</span>
				<div class="flex flex-col items-center gap-1 text-[10px] font-mono text-text-secondary">
					<span id="mobile-nav-time">10:45:23 PM</span>
					<span>DESIGN_MODE</span>
				</div>
			</div>
		</div>
	</div>
</nav>

<script>
	// 简单的实时时间更新
	const updateTime = () => {
		const timeEls = [document.getElementById('nav-time'), document.getElementById('mobile-nav-time')];
		const now = new Date();
		const timeStr = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute: '2-digit', second: '2-digit' });

		timeEls.forEach(el => {
			if (el) el.innerText = timeStr;
		});
	};
	setInterval(updateTime, 1000);
	updateTime();

	// 主题切换逻辑
	const initTheme = () => {
		const handleToggleClick = () => {
			const element = document.documentElement;
			element.classList.toggle("dark");
			const isDark = element.classList.contains("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
			updateThemeStatus();
		};

		const updateThemeStatus = () => {
			const statusEl = document.getElementById('theme-status');
			if (statusEl) {
				const isDark = document.documentElement.classList.contains("dark");
				statusEl.innerText = `THEME: ${isDark ? 'DARK_MODE' : 'LIGHT_MODE'}`;
			}
		};

		document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
		updateThemeStatus();
	};

	// 移动端菜单逻辑 - 优化动画
	const initMobileMenu = () => {
		const toggle = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		const topBar = document.getElementById('hamburger-top');
		const bottomBar = document.getElementById('hamburger-bottom');
		let isOpen = false;

		const toggleMenu = () => {
			isOpen = !isOpen;
			if (isOpen) {
				menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
				menu?.classList.add('opacity-100', 'translate-y-0');
				topBar?.classList.add('rotate-45', 'translate-y-[3.5px]');
				bottomBar?.classList.add('-rotate-45', '-translate-y-[3.5px]');
				document.body.style.overflow = 'hidden';
			} else {
				menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
				menu?.classList.remove('opacity-100', 'translate-y-0');
				topBar?.classList.remove('rotate-45', 'translate-y-[3.5px]');
				bottomBar?.classList.remove('-rotate-45', '-translate-y-[3.5px]');
				document.body.style.overflow = '';
			}
		};

		toggle?.addEventListener('click', toggleMenu);

		// 点击链接后关闭菜单
		menu?.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				if (isOpen) toggleMenu();
			});
		});
	};

	// 初始加载
	initTheme();
	initMobileMenu();
</script>
