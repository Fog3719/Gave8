---
export interface Props {
  company: string;
  companyZh?: string;
  role: string;
  period: string;
  website?: string;
  logo?: string;
  dialogId?: string;
}

const {
  company,
  companyZh = '',
  role,
  period,
  website = '',
  logo = 'resourses/sf-logo/skill-icons_wordpress.svg',
  dialogId
} = Astro.props;
---

<div class="software-list-item experience-item">
  <div class="flex flex-row gap-4 items-center flex-1">
    <img
      src={logo}
      alt={company}
      class="sw-logo-resize"
    />
    <div class="flex flex-col w-full">
      <div class="flex flex-row gap-2 items-center w-full">
        <h3 class="text-white text-base font-medium">{company}</h3>
        {website && (
          <a href={website} class="inline-block" target="_blank" rel="noopener noreferrer">
            <svg
              class="w-4 h-4 text-white opacity-70 hover:opacity-100 transition-opacity"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )}
      </div>
      {companyZh && <p class="text-white text-opacity-50 text-sm">{companyZh}</p>}
      <p class="text-white text-opacity-50 text-sm">{period}</p>
    </div>
  </div>
  {dialogId && (
    <button class="readmore" data-dialog={dialogId}>
      View
    </button>
  )}
</div>

<style>
  .experience-item {
    justify-content: space-between;
  }

  .software-list-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .software-list-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .sw-logo-resize {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .readmore {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .readmore:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  @media (min-width: 1024px) {
    .experience-item {
      justify-content: space-between;
    }
  }
</style>
