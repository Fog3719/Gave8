---
interface Props {
	title: string;
	category: string;
	image: string;
	href: string;
}

const { title, category, image, href } = Astro.props;
---

<a href={href} class="group block overflow-hidden rounded-2xl bg-gray-100 aspect-[4/3] relative">
	<img 
		src={image} 
		alt={title} 
		class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
	/>
	<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-8 text-white">
		<span class="text-xs uppercase tracking-widest font-medium opacity-80">{category}</span>
		<h3 class="text-2xl font-bold mt-1">{title}</h3>
	</div>
</a>
