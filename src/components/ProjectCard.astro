---
interface Props {
	title: string;
	category: string;
	image: string;
	href: string;
}

const { title, category, image, href } = Astro.props;
---

<div class="group relative scroll-animate" data-animate>
	<a href={href} class="block relative overflow-hidden bg-text-primary/5 aspect-[16/10] transition-colors duration-350 ease-out-quart group-hover:bg-accent/10">
		<!-- 装饰性的 CAD 准星 (Hover 时显示) -->
		<div class="absolute inset-0 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-350 ease-out-quart pointer-events-none">
			<!-- 垂直线 -->
			<div class="absolute top-0 left-1/2 w-[0.5px] h-full bg-text-primary/20 transform -translate-x-1/2 scale-y-0 group-hover:scale-y-100 transition-transform duration-500 ease-out-expo origin-top"></div>
			<!-- 水平线 -->
			<div class="absolute top-1/2 left-0 w-full h-[0.5px] bg-text-primary/20 transform -translate-y-1/2 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out-expo origin-left"></div>
			<!-- 四角定位符 -->
			<div class="absolute top-4 left-4 w-2 h-2 border-t border-l border-text-primary/40 opacity-0 group-hover:opacity-100 transition-all duration-300 ease-out-quart -translate-x-1 -translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0"></div>
			<div class="absolute top-4 right-4 w-2 h-2 border-t border-r border-text-primary/40 opacity-0 group-hover:opacity-100 transition-all duration-300 ease-out-quart translate-x-1 -translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0"></div>
			<div class="absolute bottom-4 left-4 w-2 h-2 border-b border-l border-text-primary/40 opacity-0 group-hover:opacity-100 transition-all duration-300 ease-out-quart -translate-x-1 translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0"></div>
			<div class="absolute bottom-4 right-4 w-2 h-2 border-b border-r border-text-primary/40 opacity-0 group-hover:opacity-100 transition-all duration-300 ease-out-quart translate-x-1 translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0"></div>

			<!-- 右上角的伪技术参数 -->
			<div class="absolute top-6 right-6 text-[8px] font-mono text-text-primary/40 flex flex-col items-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out-quart delay-100">
				<span>OBJ_REF: 0x{Math.floor(Math.random() * 16777215).toString(16).toUpperCase()}</span>
				<span>ZOOM_LVL: 1.05X</span>
				<span>COORD: [45.0, 120.0]</span>
			</div>
		</div>

		<img
			src={image}
			alt={title}
			class="w-full h-full object-cover img-tech opacity-60 group-hover:opacity-100 transition-all duration-700 ease-out-quart group-hover:scale-[1.02]"
			loading="lazy"
		/>

		<!-- 图片上的悬浮标签 -->
		<div class="absolute bottom-6 left-6 z-20">
			<span class="inline-block bg-accent px-3 py-1.5 rounded text-[10px] font-mono text-white border border-accent/10 opacity-0 group-hover:opacity-100 transition-all duration-350 ease-out-expo transform translate-y-3 group-hover:translate-y-0">
				VIEW_PROJECT()
			</span>
		</div>
	</a>

	<!-- 卡片下方的信息区 (非对称排版) -->
	<div class="mt-6 flex justify-between items-start">
		<div class="max-w-[70%]">
			<h3 class="text-xl md:text-2xl font-serif font-bold transition-colors duration-200 ease-out-quart leading-tight text-text-primary group-hover:text-accent">
				{title}
			</h3>
			<p class="mt-2 text-xs font-mono text-text-secondary uppercase tracking-[0.15em] transition-colors duration-200 ease-out-quart group-hover:text-text-primary/70">
				{category}
			</p>
		</div>

		<!-- 类似状态指示器的装饰 -->
		<div class="flex gap-1 items-center">
			<div class="w-1.5 h-1.5 rounded-full bg-text-primary/10 transition-all duration-500 ease-out-quart group-hover:bg-accent group-hover:scale-125"></div>
			<span class="font-mono text-[9px] text-text-secondary/50">LIVE_026</span>
		</div>
	</div>
</div>
