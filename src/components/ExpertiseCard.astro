---
export interface Props {
  title: string;
  icon: string;
  points: string[];
}

const { title, icon, points } = Astro.props;
---

<div class="Areas-list-item scroll-animation group">
  <div class="flex flex-col gap-4 items-start justify-start">
    <div class="bg-black bg-opacity-10 p-4 rounded-lg transition-all duration-300 group-hover:bg-opacity-20">
      <img src={icon} alt={title} class="areas-icon" />
    </div>
    <h3 class="text-xl font-semibold">{title}</h3>
  </div>
  {points.map((point, index) => (
    <span class={`Areas-list-item-p ${index === 0 ? '' : 'min-h-8'}`}>
      {point}
    </span>
  ))}
</div>

<style>
  .Areas-list-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .Areas-list-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .areas-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .Areas-list-item-p {
    display: block;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .min-h-8 {
    min-height: 2rem;
  }

  .scroll-animation {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .scroll-animation.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
