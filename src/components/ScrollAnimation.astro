---
export interface Props {
  delay?: number;
  threshold?: number;
  class?: string;
}

const { delay = 0, threshold = 0.3, class: className = '' } = Astro.props;
---

<div
  class={`scroll-animation-wrapper ${className}`}
  data-delay={delay}
  data-threshold={threshold}
>
  <slot />
</div>

<script>
  // Scroll animation using IntersectionObserver
  document.addEventListener('DOMContentLoaded', () => {
    const animationElements = document.querySelectorAll('.scroll-animation-wrapper');

    animationElements.forEach((element) => {
      const delay = parseInt(element.getAttribute('data-delay') || '0', 10);
      const threshold = parseFloat(element.getAttribute('data-threshold') || '0.3');

      const options = {
        root: null,
        rootMargin: '0px',
        threshold: threshold,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('active');
              observer.unobserve(entry.target);
            }, delay);
          }
        });
      }, options);

      observer.observe(element);
    });
  });
</script>

<style>
  .scroll-animation-wrapper {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    will-change: opacity, transform;
  }

  .scroll-animation-wrapper.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Variations for different animation directions */
  :global(.scroll-animation-wrapper[data-direction="left"]) {
    transform: translateX(-30px);
  }

  :global(.scroll-animation-wrapper[data-direction="left"].active) {
    transform: translateX(0);
  }

  :global(.scroll-animation-wrapper[data-direction="right"]) {
    transform: translateX(30px);
  }

  :global(.scroll-animation-wrapper[data-direction="right"].active) {
    transform: translateX(0);
  }

  :global(.scroll-animation-wrapper[data-direction="scale"]) {
    transform: scale(0.9);
  }

  :global(.scroll-animation-wrapper[data-direction="scale"].active) {
    transform: scale(1);
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .scroll-animation-wrapper {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
