//- src/templates/mixins/workdialog.pug
mixin dialog(title, description)
  .dialog-overlay(style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 1000; justify-content: center; align-items: center;")
    .dialog-box(class="bg-gray-800 p-4 rounded-lg shadow-lg m-8 w-full lg:w-1/2 lg:max-h-screen overflow-y-auto z-50")
      div(class="flex flex-col gap-4")
        h2(class="text-xl mb-2")= title
        p(class="text-sm")= description
        button(class="close-button text-xs py-2 px-2 border border-gray-400 rounded-md hover:bg-gray-100" onclick="closeDialog()") Close
