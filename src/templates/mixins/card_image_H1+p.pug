mixin card_image_H1_p(imageSrc, altText, title, description)
  div(class="bg-black bg-opacity-40 rounded-2xl shadow-lg p-4 transition-all duration-300 ease-in-out  border border-solid flex flex-col gap-4 justify-between items-start scroll-animation w-full border-gray-800")
    img(src=imageSrc, alt=altText, srcset="", class="w-full rounded-lg")
    div(class="flex flex-col h-full gap-2 min-h-max")
      h3.text-white= title
      p(class="text-white text-opacity-50 h-full ")= description