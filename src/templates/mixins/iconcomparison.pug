mixin iconComparison(oldIcon, newIcon)
  div(class="flex flex-row lg:gap-8 gap-4 h-full w-full justify-center items-center ")
      div(class="bg-black bg-opacity-60 border border-white border-opacity-20 rounded-lg p-2 shadow-md opacity-60")
        img(class="w-8 h-8 object-contain object-center  ", src=oldIcon, alt='Old Icon')
      p ➡️
      div(class="bg-black bg-opacity-60 border border-white border-opacity-20 rounded-lg p-2 shadow-md")
        img(class="w-8 h-8 object-contain object-center  ", src=newIcon, alt='Old Icon')



