mixin iconComparison(oldIcon, newIcon)
  div(class="flex flex-row lg:gap-8 gap-4 h-full w-full justify-center items-center ")
      div(class="bg-black bg-opacity-60 border border-white border-opacity-20 rounded-lg p-2 shadow-md opacity-60" style = "background-image: url('/assets/image/planning/icon-24grid-bg.svg')" )
        svg(class="w-8 h-8 object-contain object-center", viewBox="0 0 24 24", fill="currentColor", alt='Old Icon')
          use(xlink:href=`#${oldIcon}`)
      p ➡️
      div(class="bg-black bg-opacity-60 border border-white border-opacity-20 rounded-lg p-2 shadow-md" style = "background-image: url('/assets/image/planning/icon-24grid-bg.svg')")
        svg(class="w-8 h-8 object-contain object-center", viewBox="0 0 24 24", fill="currentColor", alt='New Icon')
          use(xlink:href=`#${newIcon}`)
