
include mixins/h1_p.pug

html(lang="en" class="scroll-behavior: smooth m-0 p-0 overflow-hidden" )
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title 
      block title 
        | Schematic_Hierarchy_Design
    link(rel="shortcut icon", href="assets/favicon.ico", type="image/x-icon")
    link(rel="stylesheet", href="/styles/tailwind.css")
    //- link(rel="stylesheet", href="/styles/base.css")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.6/lottie.min.js")

  body(class="bg-slate-900 text-white m-0 p-0 overflow-hidden")
    a(href="index.html" class="home-button") Return
    div(class="scrolldown")

    div(class="page flex justify-center items-center " id="p1")
         +title_P('CAD 2.0') 

    div(class="page flex justify-center items-center p-4 " id="p2")
        +title_P(
            'Project Overview', 
            '背景：随着芯片设计复杂度的增加，传统设计工具面临效率瓶颈。Chiplet 技术提供了模块化设计的新思路。',
            '目标：开发一个集成原理图、网表、3D 布局和 2D 布线的 EDA 设计平台，提高芯片设计的效率和灵活性。')
   
    div(class="page flex-col flex justify-center items-center ")
        +title_P(
            'User Research', 
            '通过访谈芯片设计工程师，我们了解他们在使用现有工具时的痛点。')
        div(class="tag-list scroll-animation")
            div(class="tag-user") 设计工具的兼容性问题
            div(class="tag-user") 仿真速度慢，尤其是在大规模时
            div(class="tag-user") 文档和支持资源不足，难以找到解决方案
            div(class="tag-user") 界面友好性不足，初学者上手难度大
            div(class="tag-user") 版本控制问题，多个成员同时修改文件时容易混淆
            div(class="tag-user") 信息共享不畅，不同工具之间的接口问题
            div(class="tag-user") 对 Chiplet 技术的接口标准化和热管理的挑战

    div(class="page flex-col flex gap-2 items-start p-4 w-full" )
        +title_P(
            'User Persona', 
            '深入访谈芯片设计工程师，了解他们使用现有工具时的挑战。',
            '',
            'flex-col flex gap-2 items-start')
        div(class="flex gap-6 flex-row w-full h-full")
            div(class="flex-col flex gap-2 w-3/10 bg-slate-800 border-slate-700 border border-solid h-full p-4 rounded-lg text-base font-light relative")
                div(class="flex-col flex gap-2 border-solid border-slate-300 gap-2 border-b py-4 h-auto" ) 
                    //- 伪元素的分割线可能因为flex布局的问题而无法显示。请检查父容器的布局设置。
                    h3 张老师
                    p 年龄:35岁
                    p 性别:男
                    p 职业:芯片设计工程师
                    p 工作经验:5年
                    p 教育背景:电气工程或相关专业硕士学位
                div(class="flex-col flex gap-2 ")
                    p 行业:半导体和电子工程
                    p 专长:数字电路设计与验证
                    p 主要项目：
                    p 消费电子芯片(如手机处理器）
                    p 通信模块(如无线通信设备）
                    p 低功耗设计(物联网设备)

            div(class="lg:flex-col lg:flex w-full gap-4  ")
                div(class="lg:flex lg:flex-col lg:gap-4  border-slate-700 border border-solid p-6 rounded-lg")
                    h2 EDA Design Process
                    ul(class="lg:flex lg:flex-row gap-6 ")
                        li(class="step") 需求分析
                        li(class="step") 架构设计
                        li(class="step") RTL 设计
                        li(class="step") 仿真验证
                        li(class="step") 合成与布局布线
                        li(class="step") 后仿真与验证
                        li(class="step") 交付制造团队

                div(class="lg:flex lg:flex-col lg:gap-10  border-slate-700 border border-solid p-6 rounded-lg h-full")
                    h2 相关公司
                    ul(class="flex flex-col lg:flex-row gap-4 lg:justify-between items-center")
                        li(class="flex flex-col gap-6 items-center")
                            img(src="/assets/image/cadence.png", alt="", srcset="" class="rounded-sm h-24") 
                            h3 界面友好，但速度慢
                        
                        li(class="flex flex-col gap-6 items-center") 
                            img(src="/assets/image/synopsys.png", alt="", srcset="" class="rounded-sm h-24")
                            h3 功能强大，稳定，但学习曲线陡峭
                        li(class="flex flex-col gap-6 items-center") 
                            img(src="/assets/image/menior.png", alt="", srcset="" class="rounded-sm h-24")
                            h3 仿真效果好，但文档不够详细
    div(class="page flex-col lg:flex-row  flex gap-2 items-center p-4 h-full justify-items-center" )
        div(class="w-1/2 m-auto")
            +title_P(
            "User Needs Analysis",
            "从用户视角出发，优化设计体验"
        )
        div(class="w-1/2")
            img(src="/assets/image/userneeds_1x.png", alt="", srcset="" class="w-1/2")
    
    div(class="page flex-col flex gap-10 items-start p-4 w-full" )
        +title_P(
            'Define the Problem', 
            '深入访谈芯片设计工程师，了解他们使用现有工具时的挑战。',
            '',
            'flex-col flex gap-2 items-start')
        div(class="flex flex-row gap-10 items-center w-full  justify-center")
            h2(class="text-2xl") 用户痛点
            div(class="flex flex-row gap-8 items-center")
                div(class="design-goals text-white") 学习曲线陡峭
                div(class="design-goals text-white") 功能不够集成
                div(class="design-goals text-white") 协作不便
        div(class="flex flex-row gap-14 items-center w-full  justify-center")
            h2(class="text-2xl") 设计目标
            div(class="flex flex-row gap-8 items-center")
                div(class="needs text-white") 简化用户体验
                div(class="needs text-white") 增强功能集成
                div(class="needs text-white") 优化协作流程


        
        


        
    
   
    script(src="/scripts/scroll.js") 
    script(src="/scripts/scrolldown.js") 
    script(src="/scripts/scroll_animation_v0.1.js") 

