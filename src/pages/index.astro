---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
	{
		title: "EDA 设计平台",
		category: "3D 布局 / 交互系统 / 半导体",
		image: "https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=1000&auto=format&fit=crop",
		href: "/projects/eda"
	},
	{
		title: "FONE_Planning",
		category: "多维预算 / Design System",
		image: "https://images.unsplash.com/photo-1561070791-26c11d204a3d?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	},
	{
		title: "Tel-UI 组件库",
		category: "前端规范 / 框架整合",
		image: "https://images.unsplash.com/photo-1551650975-87deedd944c3?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	},
	{
		title: "智慧通物联网平台",
		category: "小程序 / 后台系统",
		image: "https://images.unsplash.com/photo-1523206489230-c012c64b2b48?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	}
];
---

<Layout title="TANG XINXU | 设计与逻辑的构建者">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<!-- Hero Section -->
		<section class="max-w-4xl mb-32 md:mb-56 relative">
			<!-- 装饰性的技术标注 -->
			<div class="absolute -top-12 left-0 tech-label opacity-40 flex items-center gap-2">
				<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
				CURR_ENV: PORTFOLIO_V2.0.26
			</div>
			
			<h1 class="text-6xl md:text-[5.5rem] font-bold leading-[0.95] tracking-tight mb-12 text-text-primary">
				构建<span class="text-accent/60 font-serif relative">极度精密<span class="absolute -top-4 -right-2 text-[10px] font-mono not-italic opacity-40">[01]</span></span>的<br/>数字<span class="text-text-primary inline-block transform -skew-x-6">操作系统</span>
			</h1>

			
			<div class="flex flex-col md:flex-row gap-12 md:items-end">
				<p class="text-xl md:text-2xl text-text-secondary leading-relaxed max-w-xl font-medium">
					我是唐新旭，专注于 EDA 软件与复杂 SaaS 系统。我不仅设计界面，更在构建能够支撑复杂业务逻辑的<span class="text-text-primary underline decoration-text-primary/10 underline-offset-4">视觉基建</span>。
				</p>
				
				<!-- 补充的小字块 -->
				<div class="md:pb-1 text-[10px] font-mono text-text-secondary space-y-1">
					<p>// LOCATION: SHANGHAI, CN</p>
					<p>// FOCUS: SYSTEM_ARCHITECTURE</p>
					<p>// CURRENT: EDA_UX_LEAD</p>
				</div>
			</div>
		</section>

		<!-- Projects Section Header -->
		<div class="mb-12 flex justify-between items-end border-b border-border-primary pb-4">
			<h2 class="tech-label">SELECTED_WORKS [04]</h2>
			<div class="hidden md:block font-mono text-[9px] text-text-secondary/50">SCROLL_TO_EXPLORE_PROJECTS</div>
		</div>

		<!-- Projects Grid -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">
			{projects.map(project => (
				<ProjectCard {...project} />
			))}
		</section>

		<!-- Footer -->
		<footer class="mt-64 border-t border-border-primary pt-16 pb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
			<div class="space-y-4">
				<div class="text-lg font-mono font-medium">LET'S_COLLABORATE.</div>
				<p class="text-text-secondary max-w-sm text-sm">正在寻找能够挑战复杂性、追求极致精密的设计机会。</p>
			</div>
			
			<div class="flex flex-wrap gap-x-12 gap-y-6">
				<div class="space-y-3">
					<span class="tech-label">CONTACT</span>
					<div class="flex gap-6 text-sm font-medium">
						<a href="mailto:hello@tangxinxu.me" class="hover:text-text-secondary transition-colors underline underline-offset-4">Email</a>
						<a href="#" class="hover:text-text-secondary transition-colors underline underline-offset-4">WeChat</a>
					</div>
				</div>
				<div class="space-y-3">
					<span class="tech-label">SOCIAL</span>
					<div class="flex gap-6 text-sm font-medium text-text-secondary">
						<a href="#" class="hover:text-text-primary transition-colors">Dribbble</a>
						<a href="#" class="hover:text-text-primary transition-colors">Behance</a>
						<a href="#" class="hover:text-text-primary transition-colors">Readme</a>
					</div>
				</div>
			</div>
		</footer>
		
		<!-- 底部备案/版权 -->
		<div class="mt-24 font-mono text-[9px] text-text-secondary/50 flex justify-between">
			<span>© 2026 TANG XINXU. ALL RIGHTS RESERVED.</span>
			<span>BUILT_WITH_ASTRO_AND_LOGIC</span>
		</div>
	</main>
</Layout>
