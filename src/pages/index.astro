---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
	{
		title: "数字体验重构",
		category: "UI/UX 设计",
		image: "https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	},
	{
		title: "品牌视觉系统",
		category: "品牌设计",
		image: "https://images.unsplash.com/photo-1561070791-26c11d204a3d?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	},
	{
		title: "极简移动应用",
		category: "App 设计",
		image: "https://images.unsplash.com/photo-1551650975-87deedd944c3?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	},
	{
		title: "电商平台设计",
		category: "Web 设计",
		image: "https://images.unsplash.com/photo-1523206489230-c012c64b2b48?q=80&w=1000&auto=format&fit=crop",
		href: "#"
	}
];
---

<Layout title="作品集 | 独立设计师">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<!-- Hero Section -->
		<section class="max-w-3xl mb-24 md:mb-40">
			<h1 class="text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight mb-8">
				创造兼具<span class="text-black/40 italic font-serif">美学</span>与<span class="text-black/40 italic font-serif">功能</span>的数字体验
			</h1>
			<p class="text-xl md:text-2xl text-black/50 leading-relaxed max-w-2xl">
				我是 [你的名字]，一名专注于极简主义和用户体验的独立设计师。我帮助品牌打造触动人心的视觉方案。
			</p>
		</section>

		<!-- Projects Grid -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
			{projects.map(project => (
				<ProjectCard {...project} />
			))}
		</section>

		<!-- Footer -->
		<footer class="mt-40 border-t border-black/5 pt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-8 text-black/40 text-sm">
			<p>© 2026 DESIGNER PORTFOLIO</p>
			<div class="flex gap-8">
				<a href="#" class="hover:text-black transition-colors">Dribbble</a>
				<a href="#" class="hover:text-black transition-colors">Behance</a>
				<a href="#" class="hover:text-black transition-colors">Instagram</a>
			</div>
		</footer>
	</main>
</Layout>
