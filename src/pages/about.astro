---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

const experience = [
	{
		company: "上海奇普乐芯片科技有限公司",
		role: "交互设计师",
		period: "2024.08 - 至今",
		description: "担任 UX 用户体验设计师，负责 EDA 软件产品的整体交互/产品设计。主导并设计多个关键产品模块，涵盖 3D 布局、2D 布线、原理图和网表等。主导并完成产品 design system 的建立与维护。"
	},
	{
		company: "上海绎维软件系统有限公司",
		role: "高级交互设计师",
		period: "2023.05 - 2024.07",
		description: "在多维预算产品 FONE_Planning、合并报表等产品的设计与用户体验方面担任管理角色。建立公司内统一的产品设计系统，采用原子化设计方法和 Figma + Storybook 工具。"
	},
	{
		company: "上海展湾信息科技有限公司",
		role: "交互设计师",
		period: "2018.05 - 2019.01",
		description: "负责官网改版、小程序「智慧通 smart」产品设计以及物联网「智慧通」后台系统交互设计。更新制定平台项目设计规范。"
	},
	{
		company: "北京一起嗨网络科技有限公司",
		role: "UI 设计 / 交互设计师",
		period: "2017.02 - 2018.03",
		description: "负责公司各项目产品的 Web 端和移动端 UI 设计、用户体验、交互设计等工作。构建公司各个项目的 UI 设计规范。"
	}
];
---

<Layout title="关于我 | 资深产品设计师">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<section class="max-w-3xl">
			<h1 class="text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight mb-12">
				探索<span class="text-black/40 italic font-serif">设计</span>的深度
			</h1>
			
			<div class="space-y-8 text-xl text-black/60 leading-relaxed">
				<p>
					你好，我是作品集主人。作为资深产品设计师，我在多个项目中积累了丰富的产品设计和用户体验优化经验，专注于 Web 和移动端产品的全周期开发。
				</p>
				<p>
					我能够高效输出产品文档和交互原型，确保团队按时完成交付。凭借参与数据分析、竞品研究和用户调研的经历，我不断优化产品功能，提升用户体验和满意度。
				</p>
				<p>
					在管理方面，我曾领导设计团队，成功推动产品的改版升级和团队效率提升。具备扎实的产品思维和良好的沟通能力，始终关注设计趋势与用户需求。
				</p>
			</div>

			<div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-12 pt-20 border-t border-black/5">
				<div>
					<h2 class="text-xs uppercase tracking-widest font-bold mb-6 text-black/30">核心技能</h2>
					<ul class="space-y-3 font-medium">
						<li>产品管理 (Jira, Trello)</li>
						<li>原型设计 (Axure, Figma)</li>
						<li>数据分析与需求调研</li>
						<li>用户体验设计 (UX)</li>
						<li>竞品分析与用户调研</li>
					</ul>
				</div>
				<div>
					<h2 class="text-xs uppercase tracking-widest font-bold mb-6 text-black/30">工具与系统</h2>
					<ul class="space-y-3 font-medium">
						<li>Figma / Axure</li>
						<li>Storybook</li>
						<li>Jira / Trello</li>
						<li>Design System 建立</li>
					</ul>
				</div>
			</div>

			<div class="mt-32">
				<h2 class="text-xs uppercase tracking-widest font-bold mb-12 text-black/30">工作经历</h2>
				<div class="space-y-16">
					{experience.map(job => (
						<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-12">
							<div class="text-black/40 font-medium">{job.period}</div>
							<div class="md:col-span-2">
								<h3 class="text-2xl font-bold mb-2">{job.company}</h3>
								<div class="text-black/60 font-medium mb-4">{job.role}</div>
								<p class="text-black/50 leading-relaxed">{job.description}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="mt-40 border-t border-black/5 pt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-8 text-black/40 text-sm">
			<p>© 2026 DESIGNER PORTFOLIO</p>
			<div class="flex gap-8">
				<a href="#" class="hover:text-black transition-colors">Dribbble</a>
				<a href="#" class="hover:text-black transition-colors">Behance</a>
				<a href="#" class="hover:text-black transition-colors">Instagram</a>
			</div>
		</footer>
	</main>
</Layout>
