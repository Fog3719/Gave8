---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

const experience = [
	{
		company: "上海奇普乐芯片科技有限公司",
		role: "交互设计师",
		period: "2024.08 - 至今",
		description: "担任 UX 用户体验设计师，负责 EDA 软件产品的整体交互/产品设计。主导并设计多个关键产品模块，涵盖 3D 布局、2D 布线、原理图和网表等。主导并完成产品 design system 的建立与维护。"
	},
	{
		company: "上海绎维软件系统有限公司",
		role: "高级交互设计师",
		period: "2023.05 - 2024.07",
		description: "在多维预算产品 FONE_Planning、合并报表等产品的设计与用户体验方面担任管理角色。建立公司内统一的产品设计系统，采用原子化设计方法和 Figma + Storybook 工具。"
	},
	{
		company: "上海展湾信息科技有限公司",
		role: "交互设计师",
		period: "2018.05 - 2019.01",
		description: "负责官网改版、小程序「智慧通 smart」产品设计以及物联网「智慧通」后台系统交互设计。更新制定平台项目设计规范。"
	},
	{
		company: "北京一起嗨网络科技有限公司",
		role: "UI 设计 / 交互设计师",
		period: "2017.02 - 2018.03",
		description: "负责公司各项目产品的 Web 端和移动端 UI 设计、用户体验、交互设计等工作。构建公司各个项目的 UI 设计规范。"
	}
];
---

<Layout title="关于我 | 资深产品设计师">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<section>
			<h1 class="text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight mb-16 md:mb-24">
				探索<span class="text-text-secondary font-serif">设计</span>的深度
			</h1>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-16 md:gap-24 items-start">
				<!-- Text Column (Now 2/3 and appears first on mobile) -->
				<div class="lg:col-span-8 order-2 lg:order-1">
					<div class="space-y-8 text-xl text-text-secondary leading-relaxed max-w-2xl">
						<p>
							你好，我是唐新旭。作为资深产品设计师，我在多个项目中积累了丰富的产品设计和用户体验优化经验，专注于 Web 和移动端产品的全周期开发。
						</p>
						<p>
							我能够高效输出产品文档和交互原型，确保团队按时完成交付。凭借参与数据分析、竞品研究和用户调研的经历，我不断优化产品功能，提升用户体验和满意度。
						</p>
						<p>
							在管理方面，我曾领导设计团队，成功推动产品的改版升级 and 团队效率提升。具备扎实的产品思维和良好的沟通能力，始终关注设计趋势与用户需求。
						</p>
					</div>

					<div class="mt-20 pt-12 border-t border-border-primary">
						<div class="space-y-16">
							<!-- Software & Skills Grid -->
							<div>
								<h2 class="text-xs uppercase tracking-widest font-bold mb-10 text-text-secondary flex items-center gap-2 opacity-60">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
									专业工具与技能 / Software & Skills
								</h2>
								<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
									{[
										{ name: "Figma", desc: "Design tool", icon: "/images/tools/figma.svg" },
										{ name: "Sketch", desc: "Design tool", icon: "/images/tools/sketch.svg" },
										{ name: "Blender", desc: "3D modeling", icon: "/images/tools/blender.svg" },
										{ name: "Midjourney", desc: "AI tool", icon: "/images/tools/midjourney.svg" },
										{ name: "Rive", desc: "Animation tool", icon: "/images/tools/rive.svg" },
										{ name: "Wordpress", desc: "Web design", icon: "/images/tools/wordpress.svg" },
										{ name: "Illustrator", desc: "Vector design", icon: "/images/tools/illustrator.svg" },
										{ name: "Photoshop", desc: "Photo editing", icon: "/images/tools/photoshop.svg" }
									].map(skill => (
										<div class="flex items-center gap-4 p-4 rounded-xl border border-border-primary bg-text-primary/[0.02] hover:bg-text-primary/[0.05] hover:border-text-primary/20 transition-all group">
											<div class="w-10 h-10 flex items-center justify-center group-hover:scale-110 transition-transform">
												<img src={skill.icon} alt={skill.name} class="w-8 h-8 object-contain" />
											</div>
											<div class="flex flex-col">
												<h3 class="font-bold text-sm text-text-primary">{skill.name}</h3>
												<p class="text-xs text-text-secondary">{skill.desc}</p>
											</div>
										</div>
									))}
								</div>
							</div>

							<!-- Core Capabilities (Simplified Tags) -->
							<div>
								<h2 class="text-xs uppercase tracking-widest font-bold mb-8 text-text-secondary flex items-center gap-2 opacity-60">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
									专业领域 / Areas of Expertise
								</h2>
								<div class="flex flex-wrap gap-2">
									{["产品管理", "原型设计", "数据分析", "用户体验 (UX)", "需求调研", "交互设计", "EDA 软件设计", "设计系统建立"].map(tag => (
										<span class="px-4 py-2 rounded-lg bg-text-primary/5 border border-border-primary text-sm font-medium text-text-secondary hover:text-text-primary transition-colors cursor-default">
											{tag}
										</span>
									))}
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Photo Column (Smaller, more refined card) -->
				<div class="lg:col-span-4 order-1 lg:order-2">
					<div class="sticky top-40">
						<div class="relative group">
							<!-- Photo Frame -->
							<div class="aspect-[3/4] overflow-hidden rounded-2xl bg-border-primary relative shadow-2xl">
								<img 
									src="/images/profile.jpg" 
									alt="唐新旭 - 资深产品设计师" 
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
									style="filter: var(--img-filter);"
								/>
								<div class="absolute inset-0 pointer-events-none transition-colors duration-700" style="background-color: var(--img-overlay);"></div>
							</div>
							
							<!-- Floating Badge / Decorative Element -->
							<div class="absolute -bottom-4 -left-4 bg-black border border-border-primary p-4 rounded-xl shadow-xl hidden md:block group-hover:-translate-y-2 transition-transform duration-500">
								<p class="text-[10px] uppercase tracking-widest font-bold text-text-secondary mb-1">Based in</p>
								<p class="text-sm font-bold">Shanghai, China</p>
							</div>
							
							<!-- Decorative background blur -->
							<div class="absolute -bottom-10 -right-10 w-40 h-40 bg-text-primary/5 rounded-full -z-10 blur-3xl opacity-50"></div>
						</div>
						
						<!-- Social Links (Moved closer to photo for layout balance) -->
						<div class="mt-12 flex gap-6 justify-center lg:justify-start">
							<a href="#" class="text-text-secondary hover:text-text-primary transition-colors text-sm font-medium">Dribbble</a>
							<a href="#" class="text-text-secondary hover:text-text-primary transition-colors text-sm font-medium">Behance</a>
							<a href="#" class="text-text-secondary hover:text-text-primary transition-colors text-sm font-medium">LinkedIn</a>
						</div>
					</div>
				</div>
			</div>

			<div class="mt-40 border-t border-border-primary pt-24 max-w-5xl">
				<h2 class="text-xs uppercase tracking-widest font-bold mb-16 text-text-secondary">工作经历</h2>
				<div class="space-y-16 relative before:absolute before:inset-0 before:left-0 md:before:left-[111px] before:w-px before:bg-border-primary before:hidden md:before:block">
					{experience.map(job => (
						<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-12 relative">
							<div class="text-text-secondary font-medium pt-1">{job.period}</div>
							<div class="md:col-span-2 relative">
								<div class="absolute -left-12 top-2 w-3 h-3 rounded-full bg-text-primary hidden md:block border-4 border-black box-content"></div>
								<h3 class="text-2xl font-bold mb-2">{job.company}</h3>
								<div class="text-text-secondary font-medium mb-4">{job.role}</div>
								<p class="text-text-secondary leading-relaxed">{job.description}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="mt-40 border-t border-border-primary pt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-8 text-text-secondary text-sm">
			<p>© 2026 TANG XINXU</p>
			<div class="flex gap-8">
				<a href="#" class="hover:text-text-primary transition-colors">Dribbble</a>
				<a href="#" class="hover:text-text-primary transition-colors">Behance</a>
				<a href="#" class="hover:text-text-primary transition-colors">Instagram</a>
			</div>
		</footer>
	</main>
</Layout>
