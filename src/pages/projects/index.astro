---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const projects = [
	{
		id: "01",
		title: "Planning UI Redesign",
		category: "EPM SaaS / Design System",
		status: "DEPLOYED",
		year: "2024",
		href: "/projects/planning-redesign",
		tech: ["DESIGN_SYSTEM", "UI_REFRACTOR", "FIGMA"]
	},
	{
		id: "02",
		title: "Si bridge - 3D 布局与凹槽设计",
		category: "Semiconductor EDA / 3D Layout",
		status: "DEPLOYED",
		year: "2024",
		href: "/projects/sibridge",
		tech: ["3D_LAYOUT", "SUBSTRATE_DESIGN", "UX_LOGIC"]
	},
	{
		id: "03",
		title: "EDA 设计平台",
		category: "Semiconductor EDA / 3D Layout",
		status: "DEPLOYED",
		year: "2024",
		href: "/projects/eda",
		tech: ["THREE.JS", "WEBGL", "REACT"]
	},
	{
		id: "04",
		title: "Planning-DataStream",
		category: "Data Integration / Canvas UX",
		status: "DEPLOYED",
		year: "2023",
		href: "/projects/planning-datastream",
		tech: ["CANVAS_INTERACTION", "ETL_OPTIMIZATION", "UX_RESEARCH"]
	},
	{
		id: "05",
		title: "汽车营销返利系统访谈洞察",
		category: "User Research / B2B Logic",
		status: "COMPLETED",
		year: "2025",
		href: "/projects/marketing-research",
		tech: ["UX_RESEARCH", "USER_INTERVIEW", "STRATEGY"]
	},
	{
		id: "06",
		title: "数据钻取与自助分析平台",
		category: "Enterprise BI / Self-service Analysis",
		status: "DEPLOYED",
		year: "2022",
		href: "/projects/data-drilling",
		tech: ["BI_LOGIC", "DATA_DRILLING", "UX_DESIGN"]
	}
];
---

<Layout title="PROJECT_ARCHIVE | TANG XINXU">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<!-- Header with Technical metadata -->
		<header class="mb-24 flex flex-col md:flex-row justify-between items-end gap-8">
			<div class="max-w-2xl">
				<div class="tech-label mb-6 flex items-center gap-2">
					<span class="w-2 h-2 bg-text-primary"></span>
					DIR: /ROOT/PROJECTS/ALL
				</div>
				<h1 class="text-5xl md:text-7xl font-bold leading-tight text-text-primary">
					项目<span class="font-serif text-accent/60">存档</span>
				</h1>
			</div>
			
			<div class="text-[10px] font-mono text-text-secondary/50 text-right leading-relaxed">
				<p>TOTAL_ITEMS: {projects.length}</p>
				<p>LAST_REFRESH: {new Date().toISOString().split('T')[0]}</p>
				<p>QUERY_TIME: 0.042ms</p>
			</div>
		</header>

		<!-- Archive Table -->
		<div class="border-t border-border-primary overflow-x-auto">
			<table class="w-full text-left border-collapse min-w-[800px]">
				<thead>
					<tr class="font-mono text-[10px] text-text-secondary/50 uppercase tracking-widest border-b border-border-primary/50">
						<th class="py-6 font-medium">ID</th>
						<th class="py-6 font-medium">PROJECT_TITLE</th>
						<th class="py-6 font-medium">CATEGORY_DOMAIN</th>
						<th class="py-6 font-medium">TECH_STACK</th>
						<th class="py-6 font-medium">YEAR</th>
						<th class="py-6 font-medium text-right">STATUS</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-primary/50">
					{projects.map(project => (
						<tr class="group hover:bg-text-primary/5 transition-colors cursor-pointer" onclick={`window.location.href='${project.href}'`}>
							<td class="py-8 font-mono text-[11px] text-text-secondary/40">{project.id}</td>
							<td class="py-8">
								<a href={project.href} class="text-xl font-bold group-hover:pl-4 transition-all duration-300 block text-text-primary">
									{project.title}
								</a>
							</td>
							<td class="py-8">
								<span class="text-sm text-text-secondary font-medium italic font-serif">{project.category}</span>
							</td>
							<td class="py-8">
								<div class="flex gap-2 flex-wrap">
									{project.tech.map(t => (
										<span class="px-2 py-0.5 border border-border-primary rounded bg-bg-primary text-[9px] font-mono text-text-secondary/50 group-hover:border-text-primary/20 group-hover:text-text-secondary transition-colors">
											{t}
										</span>
									))}
								</div>
							</td>
							<td class="py-8 font-mono text-xs text-text-secondary/50">{project.year}</td>
							<td class="py-8 text-right">
								<div class="inline-flex items-center gap-2 px-3 py-1 bg-text-primary/5 rounded-full">
									<span class={`w-1 h-1 rounded-full ${project.status === 'DEPLOYED' ? 'bg-green-500' : project.status === 'MAINTENANCE' ? 'bg-blue-400' : 'bg-text-primary/20'}`}></span>
									<span class="text-[9px] font-mono font-bold tracking-widest text-text-primary">{project.status}</span>
								</div>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<!-- Bottom Status Line -->
		<div class="mt-24 p-8 border border-dashed border-border-primary rounded-2xl flex flex-col md:flex-row justify-between items-center gap-6">
			<div class="flex items-center gap-4 text-xs font-mono text-text-secondary/50">
				<span class="animate-pulse">_</span>
				<p>准备好深入了解了吗？点击上方列表查看各个项目的详细设计案例研究。</p>
			</div>
			<a href="/" class="px-6 py-2 bg-text-primary text-bg-primary text-[10px] font-mono tracking-widest hover:opacity-80 transition-colors">
				GOTO: HOME
			</a>
		</div>
	</main>
</Layout>
