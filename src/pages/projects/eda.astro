---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const project = {
  title: "EDA 设计平台 (Chiplet 技术)",
  category: "3D 布局 / 交互系统 / 工业软件",
  description: "为半导体行业设计的集成电路 EDA 平台，专注于 Chiplet 技术的原理图、网表、3D 布局及 2D 布线全流程设计。",
  role: "资深产品设计师 / UX Lead",
  period: "2024.08 - 至今",
  highlights: [
    "成功完成 EDA 产品的信息架构分析，提出围绕 3D 封装布局的交互方案",
    "提交 4 份技术交底书（专利预研），推动 EDA 软件国产化技术创新",
    "主导并建立 EDA 产品专属 Design System"
  ]
};

const designPages = [
  "/images/projects/eda/page_11-1.png",
  "/images/projects/eda/page_00.png",
  "/images/projects/eda/page_01.png",
  "/images/projects/eda/page_02.png",
  "/images/projects/eda/page_03.png",
  "/images/projects/eda/page_04.png",
  "/images/projects/eda/page_05.png",
  "/images/projects/eda/page_06.png",
  "/images/projects/eda/page_07.png",
  "/images/projects/eda/page_08.png",
  "/images/projects/eda/page_09.png",
  "/images/projects/eda/page_10.png"
];

const screenshots = [
  "/images/projects/eda/image 45.png",
  "/images/projects/eda/image 46.png",
  "/images/projects/eda/image 47.png",
  "/images/projects/eda/image 49.png",
  "/images/projects/eda/image 50.png",
  "/images/projects/eda/image 52.png"
];
---

<Layout title={`${project.title} | 作品集`}>
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<!-- Project Header -->
		<header class="max-w-3xl mb-24">
			<div class="tech-label mb-6">{project.category}</div>
			<h1 class="text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight mb-8">
				{project.title}
			</h1>
			<p class="text-xl md:text-2xl text-text-secondary leading-relaxed font-medium">
				{project.description}
			</p>
		</header>

		<!-- Hero Image (Banner) -->
		<section class="mb-32 overflow-hidden rounded-3xl bg-text-primary/5 border border-border-primary">
			<img src={designPages[0]} alt="EDA Project Hero" class="w-full h-auto object-cover" />
		</section>

		<!-- Project Meta -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-12 border-y border-border-primary mb-32">
			<div>
				<h3 class="tech-label mb-4">我的角色</h3>
				<p class="font-medium text-lg">{project.role}</p>
			</div>
			<div>
				<h3 class="tech-label mb-4">项目周期</h3>
				<p class="font-medium text-lg">{project.period}</p>
			</div>
			<div>
				<h3 class="tech-label mb-4">核心成就</h3>
				<ul class="space-y-2 font-medium text-text-secondary">
					{project.highlights.map(item => <li>• {item}</li>)}
				</ul>
			</div>
		</div>

		<!-- Project Content -->
		<div class="max-w-5xl mx-auto space-y-48">
			<!-- Section: Background & Context -->
			<section>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
					<div>
						<h2 class="text-3xl font-bold mb-8 text-text-primary">项目背景与挑战</h2>
						<div class="text-xl text-text-secondary leading-relaxed space-y-6">
							<p>
								在传统的芯片设计流程中，工程师经常需要在原理图（逻辑视图）和网表（物理视图）之间来回切换。手动对照、查找、修改和同步的过程极其耗时、枯燥，且极易引入人为错误。
							</p>
							<p>
								<strong class="text-text-primary font-bold">核心挑战：</strong> 如何革新这一工作流程，提供一个智能、高效的工具，自动化处理多层级转换和同步，确保设计数据在不同视图之间始终准确一致？
							</p>
						</div>
					</div>
					<div class="rounded-2xl overflow-hidden border border-border-primary shadow-2xl">
						<img src={designPages[1]} alt="Context" class="w-full h-auto" />
					</div>
				</div>
			</section>

			<!-- Section: Full Process Gallery (The Document) -->
			<section class="space-y-12">
				<div class="flex justify-between items-end">
					<h2 class="text-3xl font-bold text-text-primary">完整设计推导过程</h2>
					<span class="tech-label opacity-50">DESIGN_PROCESS_DOCUMENTATION</span>
				</div>
				<div class="grid grid-cols-1 gap-8">
					{designPages.slice(2).map((page, index) => (
						<div class="rounded-2xl overflow-hidden border border-border-primary bg-text-primary/5 group">
							<img src={page} alt={`Design Page ${index + 2}`} class="w-full h-auto transition-transform duration-700 group-hover:scale-[1.01]" />
						</div>
					))}
				</div>
			</section>

			<!-- Section: Solutions & Feature Showcases -->
			<section class="space-y-32">
				<div class="text-center max-w-2xl mx-auto">
					<h2 class="text-3xl font-bold mb-6 text-text-primary">核心设计方案</h2>
					<p class="text-text-secondary font-medium">针对复杂工业软件场景，构建的高效交互系统与视觉基建。</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
					<div>
						<h3 class="text-2xl font-bold mb-6 text-text-primary">智能网络识别与同步</h3>
						<p class="text-lg text-text-secondary leading-relaxed font-medium mb-8">
							无论在原理图还是网表中进行修改，系统都能智能识别并匹配对应的网络结构，自动完成另一侧的更新。
						</p>
						<div class="space-y-4">
							<div class="flex gap-3">
								<span class="text-accent font-mono text-sm">[01]</span>
								<p class="text-sm text-text-secondary">实时数据热链接，消除同步延迟。</p>
							</div>
							<div class="flex gap-3">
								<span class="text-accent font-mono text-sm">[02]</span>
								<p class="text-sm text-text-secondary">可视化冲突解决机制。</p>
							</div>
						</div>
					</div>
					<div class="rounded-2xl overflow-hidden border border-border-primary shadow-xl">
						<img src={screenshots[0]} alt="Sync Feature" class="w-full h-auto" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
					<div class="md:order-2">
						<h3 class="text-2xl font-bold mb-6 text-text-primary">3D 布局与交互系统</h3>
						<p class="text-lg text-text-secondary leading-relaxed font-medium mb-8">
							引入基于 Chiplet 技术的 3D 封装布局方案，支持多层级 3D 布局数据导入。
						</p>
						<div class="bg-text-primary/5 p-6 rounded-xl border-l-4 border-accent">
							<p class="text-sm italic text-text-secondary">“通过空间维度的扩展，我们为原本拥挤的平面布局提供了全新的组织方式。”</p>
						</div>
					</div>
					<div class="md:order-1 rounded-2xl overflow-hidden border border-border-primary shadow-xl">
						<img src={screenshots[1]} alt="3D Layout" class="w-full h-auto" />
					</div>
				</div>
			</section>

			<!-- Section: Interface Details (Masonry-like) -->
			<section class="space-y-12">
				<h2 class="text-3xl font-bold text-text-primary">交互细节与界面表现</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{screenshots.slice(2).map((img, index) => (
						<div class="rounded-xl overflow-hidden border border-border-primary bg-text-primary/5">
							<img src={img} alt={`Screenshot ${index + 3}`} class="w-full h-auto" />
						</div>
					))}
				</div>
			</section>

			<!-- Section: Results -->
			<section class="bg-text-primary text-bg-primary p-12 md:p-24 rounded-[3rem] relative overflow-hidden">
				<!-- 背景装饰 -->
				<div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
					<div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
				</div>

				<div class="relative z-10">
					<h2 class="text-3xl font-bold mb-16 text-center text-inherit">项目交付成效</h2>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-16 text-center">
						<div class="space-y-4">
							<div class="text-6xl font-bold tracking-tighter text-inherit">4 <span class="text-xl opacity-50 font-mono">FILES</span></div>
							<div class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-60 text-inherit">技术专利预研交底</div>
						</div>
						<div class="space-y-4">
							<div class="text-6xl font-bold tracking-tighter text-inherit">100%</div>
							<div class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-60 text-inherit">数据映射一致性</div>
						</div>
						<div class="space-y-4">
							<div class="text-6xl font-bold tracking-tighter text-inherit">60%</div>
							<div class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-60 text-inherit">工程操作效率提升</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Section: Reflection -->
			<section class="pb-24 border-b border-border-primary">
				<h2 class="tech-label mb-8">RETROSPECTIVE</h2>
				<div class="max-w-2xl">
					<div class="text-2xl font-serif text-text-primary leading-snug mb-8 italic">
						“在 To B 领域，复杂的功能并不意味着复杂的设计，关键在于如何将复杂性转化为易用性。”
					</div>
					<div class="text-lg text-text-secondary leading-relaxed font-medium space-y-6">
						<p>
							在 To B 领域，理解用户核心工作流程和背后的技术逻辑至关重要。通过与技术团队的深度协作，我学会了如何在有限的技术约束下找到最优的设计平衡点。
						</p>
					</div>
				</div>
			</section>
		</div>

		<!-- Next Project Prompt -->
		<div class="py-24 flex justify-center">
			<a href="/projects" class="group flex items-center gap-4 text-text-primary hover:opacity-70 transition-opacity">
				<span class="tech-label">EXPLORE_MORE_PROJECTS</span>
				<div class="w-12 h-[1px] bg-text-primary group-hover:w-20 transition-all duration-500"></div>
			</a>
		</div>

		<!-- Footer -->
		<footer class="mt-24 border-t border-border-primary pt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-8 text-text-secondary text-[10px] font-mono">
			<p>© 2026 TANG XINXU. BUILT_FOR_PRECISION.</p>
			<div class="flex gap-8">
				<a href="/" class="hover:text-text-primary transition-colors">HOME</a>
				<a href="/about" class="hover:text-text-primary transition-colors">ABOUT</a>
			</div>
		</footer>
	</main>
</Layout>
