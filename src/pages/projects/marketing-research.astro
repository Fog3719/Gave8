---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
---

<Layout title="RESEARCH_DEEP_DIVE | MARKETING_REBATE">
	<Navigation />
	
	<main class="max-w-7xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-48">
		<!-- Header Segment -->
		<header class="mb-24 flex flex-col md:flex-row justify-between items-end gap-8">
			<div class="max-w-3xl">
				<div class="tech-label mb-6 flex items-center gap-2 text-accent">
					<span class="w-2 h-2 bg-accent animate-pulse"></span>
					FILE_PATH: /PROJECTS/RESEARCH/MARKETING_REBATE_FULL.md
				</div>
				<h1 class="text-4xl md:text-7xl font-bold leading-tight text-text-primary tracking-tighter">
					汽车营销返利系统：<br/>
					<span class="font-serif italic text-text-secondary/40">从“计算器”到“价值平台”</span>
				</h1>
			</div>
			
			<div class="text-[10px] font-mono text-text-secondary/50 text-right leading-relaxed border-l border-border-primary/30 pl-6 uppercase">
				<p>SUBJECT: DEEP_USER_RESEARCH</p>
				<p>DOMAIN: ENTERPRISE_FINANCE</p>
				<p>ENTITY: SAIC_GROUP_MARKETING</p>
				<p>STATUS: VERIFIED_ANALYSIS</p>
				<p>TIMESTAMP: 2025.03.19_14:30</p>
			</div>
		</header>

		<!-- Project Brief: The Why & What -->
		<section class="mb-24">
			<div class="grid md:grid-cols-12 gap-12 border border-border-primary/50 rounded-3xl p-8 md:p-12 bg-text-primary/[0.01] relative overflow-hidden">
				<div class="absolute top-0 left-0 w-1 h-full bg-accent"></div>
				<div class="md:col-span-4">
					<h2 class="font-mono text-xs font-bold tracking-[0.4em] uppercase text-text-secondary/40 mb-4">Research_Context</h2>
					<h3 class="text-xl font-bold text-text-primary tracking-tight">项目背景与调研目标</h3>
				</div>
				<div class="md:col-span-8 space-y-6">
					<p class="text-text-secondary leading-relaxed text-sm md:text-base">
						这是一份针对 <span class="text-text-primary font-bold">XX 汽车企业营销返利业务</span> 的用户深度访谈调研报告。该业务涉及多变的商务政策、频繁的例外处理及跨部门数据协作，是企业营销数字化转型中最具挑战的环节之一。
					</p>
					<div class="grid md:grid-cols-2 gap-8 pt-6 border-t border-border-primary/20">
						<div class="space-y-2">
							<span class="font-mono text-[9px] text-accent uppercase tracking-widest font-bold">Objective_01</span>
							<p class="text-[11px] text-text-secondary leading-relaxed italic">深入业务一线，还原财务核算人员在极端非标场景下的真实工作流与痛点。</p>
						</div>
						<div class="space-y-2">
							<span class="font-mono text-[9px] text-accent uppercase tracking-widest font-bold">Objective_02</span>
							<p class="text-[11px] text-text-secondary leading-relaxed italic">识别现有工具（Excel/旧系统）的瓶颈，探寻从“工具化”向“平台化”转型的关键契机。</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Meta Section: Methodology & Persona -->
		<div class="grid grid-cols-1 md:grid-cols-12 gap-12 border-t border-border-primary pt-12 mb-24">
			<div class="md:col-span-4 space-y-8">
				<div class="p-8 border border-border-primary rounded-2xl bg-text-primary/[0.02]">
					<div class="font-mono text-[10px] text-text-secondary/40 mb-6 uppercase tracking-[0.2em]">User_Profile</div>
					<div class="flex items-center gap-4 mb-6">
						<div class="w-14 h-14 rounded-full border border-border-primary flex items-center justify-center font-serif text-2xl italic bg-bg-primary text-accent">N</div>
						<div>
							<h3 class="font-bold text-text-primary text-xl">N 先生</h3>
							<p class="font-mono text-[9px] text-text-secondary/60 uppercase">营销支持科业务主管</p>
						</div>
					</div>
					<div class="space-y-4 text-xs text-text-secondary leading-relaxed font-mono opacity-80">
						<p>[CONTEXT] 隶属于财务部，负责支持销售业务和控制销售相关费用。</p>
						<p>[CORE_TASK] 核心职责为返利核算，同时负责经销商经营数据分析。</p>
					</div>
				</div>

				<div class="p-8 border border-dashed border-border-primary rounded-2xl">
					<div class="font-mono text-[10px] text-text-secondary/40 mb-6 uppercase tracking-[0.2em]">Research_Methods</div>
					<div class="space-y-4 font-mono text-[10px] text-text-secondary/60">
						<div class="flex justify-between border-b border-border-primary/30 pb-2">
							<span>METHOD</span>
							<span class="text-text-primary">FACE_TO_FACE_INTERVIEW</span>
						</div>
						<div class="flex justify-between border-b border-border-primary/30 pb-2">
							<span>DURATION</span>
							<span class="text-text-primary">90_MINS</span>
						</div>
						<div class="flex justify-between border-b border-border-primary/30 pb-2">
							<span>FOCUS</span>
							<span class="text-text-primary">REBATE_WORKFLOW_PAINPOINTS</span>
						</div>
					</div>
				</div>
			</div>

			<div class="md:col-span-8 flex flex-col justify-center">
				<div class="relative pl-12">
					<div class="absolute -top-16 -left-4 text-[160px] font-serif text-text-primary/[0.03] leading-none select-none italic">“</div>
					<p class="text-3xl md:text-5xl font-serif italic text-text-primary leading-tight relative z-10 mb-8">
						“我们想要的<span class="text-accent">不是一个计算器</span>，而是如何发挥数字的价值，甚至可以评价商务政策的效益。”
					</p>
					<div class="flex items-center gap-4">
						<div class="h-[1px] w-12 bg-accent/40"></div>
						<span class="font-mono text-[10px] uppercase tracking-widest text-text-secondary/40">The fundamental shift in user expectation</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Main Findings: High Density List -->
		<section class="mb-32">
			<div class="flex items-center gap-6 mb-16">
				<h2 class="font-mono text-xs font-bold tracking-[0.4em] uppercase text-accent">Section_01: Key_Findings</h2>
				<div class="flex-grow h-[1px] bg-border-primary/30"></div>
				<span class="font-mono text-[10px] text-text-secondary/30">[ARRAY_SIZE: 05]</span>
			</div>

			<div class="grid gap-24">
				<!-- Finding 01 -->
				<div class="grid md:grid-cols-12 gap-8 group">
					<div class="md:col-span-1 font-mono text-2xl text-accent/20 transition-colors group-hover:text-accent font-bold">01</div>
					<div class="md:col-span-11 space-y-6">
						<div class="space-y-2">
							<h4 class="text-2xl font-bold text-text-primary tracking-tight">政策管理与配置的极端复杂性</h4>
							<p class="text-text-secondary/60 font-mono text-[10px] uppercase tracking-wider italic">High-Frequency Policy Mutations</p>
						</div>
						<div class="grid md:grid-cols-2 gap-12">
							<div class="text-text-secondary leading-relaxed text-sm md:text-base space-y-4">
								<p>商务政策数量庞大且变动极其频繁（每年、每月甚至每周）。这种变动直接导致业务人员需要不断重新编排计算逻辑。</p>
								<div class="p-4 bg-text-primary/5 border-l-2 border-accent/40 text-xs italic">
									"一套政策如果不随源数据变化，就无法反映市场认可度... 永远有新的政策，永远要重新编排逻辑。"
								</div>
							</div>
							<div class="space-y-4 p-6 border border-border-primary/30 rounded-xl bg-text-primary/[0.01]">
								<div class="font-mono text-[9px] text-text-secondary/40 uppercase tracking-widest">Technical_Implication</div>
								<p class="text-xs text-text-secondary/80 leading-relaxed italic font-serif">
									这要求系统具备极高的配置灵活性，而非固化的硬编码逻辑。
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Finding 02 -->
				<div class="grid md:grid-cols-12 gap-8 group pt-16 border-t border-border-primary/20">
					<div class="md:col-span-1 font-mono text-2xl text-accent/20 transition-colors group-hover:text-accent font-bold">02</div>
					<div class="md:col-span-11 space-y-6">
						<div class="space-y-2">
							<h4 class="text-2xl font-bold text-text-primary tracking-tight">“非标业务”对自动化流程的冲击</h4>
							<p class="text-text-secondary/60 font-mono text-[10px] uppercase tracking-wider italic">Special Approval vs. Automation</p>
						</div>
						<div class="text-text-secondary leading-relaxed text-sm md:text-base max-w-3xl space-y-6">
							<p>存在大量“特批报告”，会推翻之前的核算结果。这种不确定性导致了严重的重复劳动。</p>
							<div class="flex gap-8 items-center bg-accent text-bg-primary p-6 rounded-2xl shadow-xl shadow-accent/10">
								<p class="text-2xl font-serif italic">“曾经我最多的一个奖项，我对着算了 8 遍。”</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Finding 03 -->
				<div class="grid md:grid-cols-12 gap-8 group pt-16 border-t border-border-primary/20">
					<div class="md:col-span-1 font-mono text-2xl text-accent/20 transition-colors group-hover:text-accent font-bold">03</div>
					<div class="md:col-span-11 space-y-6">
						<div class="space-y-2">
							<h4 class="text-2xl font-bold text-text-primary tracking-tight">数据有效性的动态博弈</h4>
							<p class="text-text-secondary/60 font-mono text-[10px] uppercase tracking-wider italic">Dynamic Validity Assessment</p>
						</div>
						<div class="text-text-secondary leading-relaxed text-sm md:text-base max-w-3xl">
							<p>核算时必须判断车辆在当前时间点是否仍然有效（如退车、补录）。这种基于时间维度的状态判断，让简单的计算变成了复杂的“有效性判定”。</p>
							<div class="mt-4 p-4 border border-border-primary/30 rounded font-mono text-[11px] bg-text-primary/[0.03]">
								// LOG_ENTRY: "站在我算奖的时间点上，看某个月奖金的时候，我要判断这台车在我这个点上是否还有效。"
							</div>
						</div>
					</div>
				</div>

				<!-- Finding 04 -->
				<div class="grid md:grid-cols-12 gap-8 group pt-16 border-t border-border-primary/20">
					<div class="md:col-span-1 font-mono text-2xl text-accent/20 transition-colors group-hover:text-accent font-bold">04</div>
					<div class="md:col-span-11 space-y-6">
						<div class="space-y-2">
							<h4 class="text-2xl font-bold text-text-primary tracking-tight">核对成本：不可逾越的人工鸿沟</h4>
							<p class="text-text-secondary/60 font-mono text-[10px] uppercase tracking-wider italic">The Cost of Accuracy</p>
						</div>
						<p class="text-text-secondary leading-relaxed text-sm md:text-base max-w-3xl">
							目前的“审公式”逻辑完全依靠人工逐条比对政策文本。这种原始的核对方式效率极低，且没有任何系统支持的验证机制。
						</p>
					</div>
				</div>

				<!-- Finding 05 -->
				<div class="grid md:grid-cols-12 gap-8 group pt-16 border-t border-border-primary/20">
					<div class="md:col-span-1 font-mono text-2xl text-accent/20 transition-colors group-hover:text-accent font-bold">05</div>
					<div class="md:col-span-11 space-y-6">
						<div class="space-y-2">
							<h4 class="text-2xl font-bold text-text-primary tracking-tight">沉睡的数据：价值发挥的真空带</h4>
							<p class="text-text-secondary/60 font-mono text-[10px] uppercase tracking-wider italic">Latent Data Value</p>
						</div>
						<p class="text-text-secondary leading-relaxed text-sm md:text-base max-w-3xl">
							用户迫切需要通过返利数据分析经销商状态（如：奖金消耗速度、Call车意向等），从而为公司销售策略提供反馈。但现有系统仅停留在“算账”层面。
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Deep Analysis Segment -->
		<section class="mb-32 p-12 md:p-20 bg-text-primary rounded-[3rem] text-bg-primary relative overflow-hidden">
			<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent blur-[150px] opacity-10 -mr-64 -mt-64"></div>
			
			<div class="relative z-10 grid md:grid-cols-12 gap-16">
				<div class="md:col-span-4">
					<h2 class="font-mono text-xs font-bold tracking-[0.4em] uppercase opacity-40 mb-8">Section_02: Core_Analysis</h2>
					<h3 class="text-3xl font-serif italic mb-6 leading-tight text-accent">从“效率工具”向“战略内核”的位移</h3>
					<div class="w-12 h-1 bg-accent/40 mb-8"></div>
				</div>
				<div class="md:col-span-8 space-y-8">
					<div class="space-y-6 text-sm md:text-base opacity-80 leading-relaxed font-light">
						<p>
							访谈揭示了一个深刻的矛盾：企业试图通过复杂的商务政策来对冲市场的不确定性，而这种复杂性最终转化为了财务人员沉重的劳动成本。
						</p>
						<p>
							<span class="text-accent font-bold">核心错位：</span> 现有的系统逻辑是基于“标准快照”设计的，而真实的业务逻辑是“流动的、可追溯的”。一旦特批报告推翻历史结果，固化的系统逻辑就会崩溃。
						</p>
						<p>
							真正的用户痛点不在于“计算慢”，而在于“无法记录变动轨迹”。没有历史追溯和记录，用户在年底复盘时就会陷入记忆的盲区。
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Recommendations: The Action Plan -->
		<section class="mb-32">
			<div class="flex items-center gap-6 mb-16">
				<h2 class="font-mono text-xs font-bold tracking-[0.4em] uppercase text-accent">Section_03: Design_Strategy</h2>
				<div class="flex-grow h-[1px] bg-border-primary/30"></div>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<!-- Rec 01 -->
				<div class="p-8 border border-border-primary rounded-2xl space-y-6 hover:bg-text-primary/[0.02] transition-colors">
					<div class="font-mono text-accent text-xs">01_ANALYTICS</div>
					<h4 class="font-bold text-lg">引入“效益性评估”模型</h4>
					<p class="text-xs text-text-secondary leading-relaxed">
						不仅计算返利，更要通过多维度分析（区域、车型、经销商）评估商务政策的真实ROI，将系统升级为决策大脑。
					</p>
				</div>

				<!-- Rec 02 -->
				<div class="p-8 border border-border-primary rounded-2xl space-y-6 hover:bg-text-primary/[0.02] transition-colors">
					<div class="font-mono text-accent text-xs">02_FLEXIBILITY</div>
					<h4 class="font-bold text-lg">可视化公式编排引擎</h4>
					<p class="text-xs text-text-secondary leading-relaxed">
						模仿 Excel 的逻辑习惯，提供图形化的政策配置工具。降低人工编写逻辑的门槛，并实现自动化的“公式核对”。
					</p>
				</div>

				<!-- Rec 03 -->
				<div class="p-8 border border-border-primary rounded-2xl space-y-6 hover:bg-text-primary/[0.02] transition-colors">
					<div class="font-mono text-accent text-xs">03_TRACING</div>
					<h4 class="font-bold text-lg">全生命周期审计追踪</h4>
					<p class="text-xs text-text-secondary leading-relaxed">
						建立针对特批、退车等例外情况的标准化处理流程。系统应自动记录所有逻辑变更历史，确保年底复盘“有据可查”。
					</p>
				</div>
			</div>
		</section>

		<!-- Final Status Line -->
		<footer class="pt-12 border-t border-border-primary/50 flex flex-col md:flex-row justify-between items-center gap-6">
			<div class="flex items-center gap-4 text-[10px] font-mono text-text-secondary/30 uppercase tracking-[0.2em]">
				<span>END_OF_DOCUMENT</span>
				<span class="w-1.5 h-1.5 rounded-full bg-accent/40"></span>
				<span>VERSION_2025.03.19</span>
			</div>
			<div class="flex gap-8 items-center">
				<a href="/projects" class="text-[10px] font-mono font-bold border-b border-text-primary/20 pb-1 hover:text-accent hover:border-accent transition-all">RETURN_TO_ARCHIVE</a>
				<span class="text-[10px] font-mono text-text-secondary/20 select-none">SHA256: 86652_ANALYSIS_MARKETING</span>
			</div>
		</footer>
	</main>
</Layout>

<style>
	/* Custom styles for high-density research reading */
	h1, h2, h3, h4 { letter-spacing: -0.02em; }
	.font-serif { font-family: 'Playfair Display', serif; }
</style>
